diff --git a/es-app/src/guis/GuiCoinWait.cpp b/es-app/src/guis/GuiCoinWait.cpp
new file mode 100644
index 0000000..040c78b
--- /dev/null
+++ b/es-app/src/guis/GuiCoinWait.cpp
@@ -0,0 +1,81 @@
+#include "guis/GuiCoinWait.h"
+
+#include "components/TextComponent.h"
+#include "resources/Font.h"
+#include "renderers/Renderer.h"
+#include "TimerManager.h"
+#include "LocaleES.h"
+
+GuiCoinWait::GuiCoinWait(Window* window, const std::function<void()>& onReady)
+	: GuiComponent(window), mOnReady(onReady), mPollTimer(0)
+{
+	float width = Renderer::getScreenWidth();
+	float height = Renderer::getScreenHeight();
+
+	setSize(width, height);
+
+	mMessage = std::make_shared<TextComponent>(mWindow, _("INSERT COIN TO PLAY"), Font::get(FONT_SIZE_LARGE), 0xFFFFFFFF, ALIGN_CENTER);
+	mMessage->setSize(width, 0);
+	mMessage->setPosition(0, height * 0.42f);
+
+	mSubMessage = std::make_shared<TextComponent>(
+		mWindow,
+		_("PRESS THE CONFIGURED COIN KEY OR INSERT A COIN"), Font::get(FONT_SIZE_SMALL), 0xCCCCCCFF, ALIGN_CENTER);
+	mSubMessage->setSize(width, 0);
+	mSubMessage->setPosition(0, height * 0.42f + Font::get(FONT_SIZE_LARGE)->getLetterHeight() * 2.0f);
+}
+
+void GuiCoinWait::closeAndRun(const std::function<void()>& func)
+{
+	auto funcCopy = func;
+	delete this;
+
+	if (funcCopy)
+		funcCopy();
+}
+
+bool GuiCoinWait::input(InputConfig* config, Input input)
+{
+	if (input.value != 0 && config->isMappedTo(BUTTON_BACK, input))
+	{
+		closeAndRun(nullptr);
+		return true;
+	}
+
+	return true; // swallow everything else while waiting for a coin
+}
+
+void GuiCoinWait::update(int deltaTime)
+{
+	GuiComponent::update(deltaTime);
+
+	mPollTimer -= deltaTime;
+	if (mPollTimer > 0)
+		return;
+
+	mPollTimer = 200;
+
+	if (TimerManager::getInstance()->isEnabled() && TimerManager::getInstance()->remainingSeconds() > 0)
+	{
+		auto func = mOnReady;
+		closeAndRun(func);
+	}
+}
+
+void GuiCoinWait::render(const Transform4x4f& parentTrans)
+{
+	Transform4x4f trans = getTransform() * parentTrans;
+	Renderer::setMatrix(trans);
+
+	Renderer::drawRect(0.0f, 0.0f, Renderer::getScreenWidth(), Renderer::getScreenHeight(), 0x000000E0, 0x000000E0);
+
+	mMessage->render(trans);
+	mSubMessage->render(trans);
+}
+
+std::vector<HelpPrompt> GuiCoinWait::getHelpPrompts()
+{
+	std::vector<HelpPrompt> prompts;
+	prompts.push_back(HelpPrompt(BUTTON_BACK, _("CANCEL")));
+	return prompts;
+}
