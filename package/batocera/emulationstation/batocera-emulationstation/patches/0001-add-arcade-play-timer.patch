diff --git a/es-core/src/TimerManager.cpp b/es-core/src/TimerManager.cpp
new file mode 100644
index 0000000..be29be4
--- /dev/null
+++ b/es-core/src/TimerManager.cpp
@@ -0,0 +1,175 @@
+#include "TimerManager.h"
+
+#include <SDL.h>
+#include <algorithm>
+#include <cctype>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+
+#include "SystemConf.h"
+#include "utils/FileSystemUtil.h"
+
+namespace
+{
+const char* STATE_FILE = "/userdata/system/configs/timer/timeleft";
+const char* STATE_DIR  = "/userdata/system/configs/timer";
+const char* LAST_EXIT  = "/run/batocera-timer/last_exit";
+
+std::string toLower(std::string value)
+{
+	std::transform(value.begin(), value.end(), value.begin(),
+		[](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+	return value;
+}
+
+int toInt(const std::string& value, int defaultValue)
+{
+	if (value.empty())
+		return defaultValue;
+
+	char* end = nullptr;
+	long parsed = std::strtol(value.c_str(), &end, 10);
+	if (end == nullptr || *end != '\0')
+		return defaultValue;
+
+	return (int)parsed;
+}
+} // namespace
+
+TimerManager* TimerManager::getInstance()
+{
+	static TimerManager instance;
+	return &instance;
+}
+
+bool TimerManager::isEnabled()
+{
+	return SystemConf::getInstance()->get("timer.enabled") == "1";
+}
+
+int TimerManager::addMinutesPerCoin()
+{
+	return std::max(1, toInt(SystemConf::getInstance()->get("timer.add.minutes"), 5));
+}
+
+int TimerManager::warnSeconds()
+{
+	return std::max(0, toInt(SystemConf::getInstance()->get("timer.warn"), 30));
+}
+
+std::string TimerManager::coinKeyName() const
+{
+	std::string key = SystemConf::getInstance()->get("timer.coin.key");
+	return key.empty() ? "5" : key; // classic MAME coin key
+}
+
+int TimerManager::readStateFile() const
+{
+	if (!Utils::FileSystem::exists(STATE_FILE, false))
+		return 0;
+
+	std::ifstream stream(STATE_FILE);
+	std::string content;
+	std::getline(stream, content);
+	stream.close();
+
+	return std::max(0, toInt(content, 0));
+}
+
+void TimerManager::writeStateFile(int seconds) const
+{
+	Utils::FileSystem::createDirectory(STATE_DIR);
+
+	std::string temporary = std::string(STATE_FILE) + ".tmp";
+	{
+		std::ofstream stream(temporary);
+		stream << std::max(0, seconds) << "\n";
+		stream.close();
+	}
+
+	std::rename(temporary.c_str(), STATE_FILE);
+}
+
+int TimerManager::remainingSeconds()
+{
+	time_t now = time(nullptr);
+	if (mLastRead == now)
+		return mCachedRemaining;
+
+	mLastRead = now;
+	mCachedRemaining = readStateFile();
+	return mCachedRemaining;
+}
+
+std::string TimerManager::remainingFormatted()
+{
+	int total = remainingSeconds();
+
+	char buffer[16];
+	std::snprintf(buffer, sizeof(buffer), "%02d:%02d:%02d", total / 3600, (total / 60) % 60, total % 60);
+	return std::string(buffer);
+}
+
+bool TimerManager::coinKeyMatches(int sdlKeycode) const
+{
+	std::string configured = toLower(coinKeyName());
+	if (configured.empty())
+		return false;
+
+	const char* pressed = SDL_GetKeyName((SDL_Keycode)sdlKeycode);
+	if (pressed == nullptr || *pressed == '\0')
+		return false;
+
+	return toLower(pressed) == configured;
+}
+
+int TimerManager::insertCoin()
+{
+	if (!isEnabled())
+		return 0;
+
+	Uint32 now = SDL_GetTicks();
+	if (now - mLastCoinInsert < 300) // debounce the switch / keyboard repeat
+		return 0;
+
+	int minutes = addMinutesPerCoin();
+	if (minutes <= 0)
+		return 0;
+
+	mLastCoinInsert = now;
+	writeStateFile(remainingSeconds() + minutes * 60);
+	mCachedRemaining += minutes * 60;
+	return minutes;
+}
+
+void TimerManager::ensureStateFile()
+{
+	if (Utils::FileSystem::exists(STATE_FILE, false))
+		return;
+
+	int minutes = std::max(0, toInt(SystemConf::getInstance()->get("timer.initial"), 0));
+	writeStateFile(minutes * 60);
+	mLastRead = 0;
+}
+
+void TimerManager::resetState()
+{
+	int minutes = std::max(0, toInt(SystemConf::getInstance()->get("timer.initial"), 0));
+	writeStateFile(minutes * 60);
+	mLastRead = 0;
+}
+
+bool TimerManager::consumeTimeoutMarker()
+{
+	if (!Utils::FileSystem::exists(LAST_EXIT, false))
+		return false;
+
+	std::ifstream stream(LAST_EXIT);
+	std::string content;
+	std::getline(stream, content);
+	stream.close();
+
+	Utils::FileSystem::removeFile(LAST_EXIT);
+	return content == "timeout";
+}
diff --git a/es-core/src/TimerManager.h b/es-core/src/TimerManager.h
new file mode 100644
index 0000000..3a931e4
--- /dev/null
+++ b/es-core/src/TimerManager.h
@@ -0,0 +1,45 @@
+#pragma once
+#ifndef ES_CORE_TIMER_MANAGER_H
+#define ES_CORE_TIMER_MANAGER_H
+
+#include <string>
+#include <ctime>
+
+// Arcade / parental play timer shared between the frontend (this process) and
+// the batocera-launch process. The authoritative state is a plain-text file
+// with the seconds of play time remaining:
+//
+//   /userdata/system/configs/timer/timeleft
+//
+// While a game runs, batocera-launch decreases it; coins inserted there extend
+// the running session. Here in the frontend we display it, block launches when
+// it reaches zero and add time when the coin input (configured key) is pressed.
+class TimerManager
+{
+public:
+	static TimerManager* getInstance();
+
+	bool isEnabled();                 // timer.enabled == "1"
+	int  addMinutesPerCoin();         // timer.add.minutes
+	int  warnSeconds();               // timer.warn
+	int  remainingSeconds();          // seconds left (cached, 1 s granularity)
+	std::string remainingFormatted(); // HH:MM:SS
+	std::string coinKeyName() const;   // timer.coin.key
+	bool coinKeyMatches(int sdlKeycode) const;
+	int  insertCoin();                // adds addMinutesPerCoin() minutes, returns minutes added (0 if debounced)
+	void ensureStateFile();           // create the state file from timer.initial if missing
+	void resetState();                // write timer.initial (used by the settings menu)
+	bool consumeTimeoutMarker();      // true if the last game ended because the time ran out
+
+private:
+	TimerManager() = default;
+
+	int  readStateFile() const;
+	void writeStateFile(int seconds) const;
+
+	time_t mLastRead = 0;
+	int    mCachedRemaining = 0;
+	unsigned int mLastCoinInsert = 0;
+};
+
+#endif // ES_CORE_TIMER_MANAGER_H
