@@ -0,0 +1,92 @@
+#include "guis/GuiPlayTimerSettings.h"
+
+#include <algorithm>
+#include <cstdlib>
+
+#include "components/SliderComponent.h"
+#include "components/SwitchComponent.h"
+#include "components/TextComponent.h"
+#include "resources/Font.h"
+#include "SystemConf.h"
+#include "TimerManager.h"
+#include "LocaleES.h"
+#include "Window.h"
+
+GuiPlayTimerSettings::GuiPlayTimerSettings(Window* window) : GuiSettings(window, _("PLAY TIMER SETTINGS").c_str())
+{
+	auto* timer = TimerManager::getInstance();
+
+	addGroup(_("PLAY TIMER"));
+
+	// Master switch (the state file is ensured below, after timer.initial is saved)
+	addSwitch(
+		_("ENABLE PLAY TIMER"),
+		_("Time is only consumed while a game is running and is shown as HH:MM:SS in the menus"),
+		"timer.enabled", false);
+
+	// Minutes of play time added by each coin
+	auto coinMinutes = std::make_shared<SliderComponent>(mWindow, 1.f, 60.f, 1.f, "min");
+	coinMinutes->setValue((float)timer->addMinutesPerCoin());
+	addWithLabel(_("MINUTES PER COIN"), coinMinutes);
+	addSaveFunc([coinMinutes]
+	{
+		SystemConf::getInstance()->set("timer.add.minutes", std::to_string((int)coinMinutes->getValue()));
+	});
+
+	// Warning time before the game is closed when the time runs out
+	auto warnSeconds = std::make_shared<SliderComponent>(mWindow, 0.f, 120.f, 5.f, "s");
+	warnSeconds->setValue((float)timer->warnSeconds());
+	addWithLabel(_("CLOSING GRACE PERIOD"), warnSeconds);
+	addSaveFunc([warnSeconds]
+	{
+		SystemConf::getInstance()->set("timer.warn", std::to_string((int)warnSeconds->getValue()));
+	});
+
+	// Time loaded when the timer is enabled / reset
+	auto initialMinutes = std::make_shared<SliderComponent>(mWindow, 0.f, 240.f, 5.f, "min");
+	initialMinutes->setValue((float)std::max(0, atoi(SystemConf::getInstance()->get("timer.initial").c_str())));
+	addWithLabel(_("TIME WHEN ENABLED / RESET"), initialMinutes);
+	addSaveFunc([initialMinutes]
+	{
+		SystemConf::getInstance()->set("timer.initial", std::to_string((int)initialMinutes->getValue()));
+	});
+
+	// Create the state file once everything (including timer.initial) is persisted
+	addSaveFunc([timer]
+	{
+		if (SystemConf::getInstance()->getBool("timer.enabled"))
+			timer->ensureStateFile();
+	});
+
+	addGroup(_("COIN ACCEPTOR"));
+
+	addInputTextConfigRow(_("COIN KEY (SDL NAME)"), "timer.coin.key", false, false);
+	addEntry(_("DEFAULT: 5 - THE COIN SWITCH IS USUALLY WIRED TO A KEYBOARD ENCODER"), false);
+
+	addInputTextConfigRow(_("COIN DEVICE (NAME PART)"), "timer.coin.device", false, false);
+	addEntry(_("OPTIONAL: WATCH A DEDICATED INPUT DEVICE WHILE GAMES RUN, E.G. 'COIN'"), false);
+
+	addGroup(_("ACTIONS"));
+
+	// Current remaining time (read-only snapshot at open)
+	auto timeLeftText = std::make_shared<TextComponent>(mWindow, timer->remainingFormatted(), Font::get(FONT_SIZE_MEDIUM), 0xFFFFFFFF);
+	addWithLabel(_("TIME LEFT"), timeLeftText);
+
+	addEntry(_("SIMULATE A COIN"), true, [this, timer]
+	{
+		int minutes = timer->insertCoin();
+		if (minutes > 0)
+			mWindow->displayNotificationMessage("+ " + std::to_string(minutes) + " " + _("MIN"));
+	});
+
+	addEntry(_("RESET TIME"), true, [this, timer]
+	{
+		timer->resetState();
+		mWindow->displayNotificationMessage(_("TIME RESET"));
+	});
+
+	addGroup(_("INFO"));
+
+	addEntry(_("AT 00:00:00 NO GAME CAN START UNTIL A COIN ADDS TIME"), false);
+	addEntry(_("A COIN DURING THE CLOSING GRACE PERIOD EXTENDS THE RUNNING GAME"), false);
+}
