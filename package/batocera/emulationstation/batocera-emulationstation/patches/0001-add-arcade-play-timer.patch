+#pragma once
+#ifndef ES_APP_GUIS_GUI_COIN_WAIT_H
+#define ES_APP_GUIS_GUI_COIN_WAIT_H
+
+#include "GuiComponent.h"
+#include "HelpPrompt.h"
+
+#include <functional>
+#include <memory>
+#include <vector>
+
+class TextComponent;
+
+// Fullscreen "insert coin" screen shown when trying to launch a game without any
+// play time left. It polls the play timer and, as soon as a coin adds time,
+// closes itself and runs the stored callback (which relaunches the game).
+class GuiCoinWait : public GuiComponent
+{
+public:
+	GuiCoinWait(Window* window, const std::function<void()>& onReady);
+
+	bool input(InputConfig* config, Input input) override;
+	void update(int deltaTime) override;
+	void render(const Transform4x4f& parentTrans) override;
+	std::vector<HelpPrompt> getHelpPrompts() override;
+	std::string getValue() const override { return "GuiCoinWait"; }
+
+private:
+	void closeAndRun(const std::function<void()>& func);
+
+	std::shared_ptr<TextComponent> mMessage;
+	std::shared_ptr<TextComponent> mSubMessage;
+	std::function<void()> mOnReady;
+	int mPollTimer;
+};
+
+#endif // ES_APP_GUIS_GUI_COIN_WAIT_H
